# udev rule for ESP32-S3 GPU Fan Controller
# Creates stable symlink at /dev/gpu-fan-ctrl
#
# Install: sudo cp 99-gpu-fan-ctrl.rules /etc/udev/rules.d/
# Reload:  sudo udevadm control --reload-rules && sudo udevadm trigger
#
# Matches THIS specific ESP32 board by serial number
# Find yours with: udevadm info -a -n /dev/ttyACM* | grep serial
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{serial}=="5577018485", SYMLINK+="gpu-fan-ctrl", MODE="0666"

# Disable USB autosuspend for this device to prevent watchdog timeouts
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="1a86", ATTR{serial}=="5577018485", ATTR{power/autosuspend_delay_ms}="-1"

# Keep the AMD Radeon Pro V620 (1002:73a1) awake (D0) so hwmon temps are readable.
# Without this the card runtime-suspends to D3cold when idle/headless and every
# /sys read (temps, gpu_metrics, pp_dpm_*) returns EBUSY.
ACTION=="add", SUBSYSTEM=="pci", ATTR{vendor}=="0x1002", ATTR{device}=="0x73a1", ATTR{power/control}="on"
